# Copy to .env for local use. NEVER commit the real .env (it is in .gitignore).
# Gemini API key (https://aistudio.google.com/apikey). The key stays on the server and never reaches the browser.
# If you leave it empty, paste your key in the app: Einstellungen → Gemini API (stored only in your browser).
GOOGLE_API_KEY=
# Optional: a shared password players must enter, so strangers can't spend your credits on a public URL.
ACCESS_CODE=
PORT=3000
